diff --git a/src/main/java/puregero/multipaper/util/PacketSerializer.java b/src/main/java/puregero/multipaper/util/PacketSerializer.java
new file mode 100644
index 0000000000000000000000000000000000000000..b53fe5c4f64a948eeb2a4123cf58a8da4c3f36a5
--- /dev/null
+++ b/src/main/java/puregero/multipaper/util/PacketSerializer.java
@@ -0,0 +1,51 @@
+package puregero.multipaper.util;
+
+import io.netty.buffer.Unpooled;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.ProtocolInfo;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.game.ClientGamePacketListener;
+import net.minecraft.network.protocol.game.GameProtocols;
+import net.minecraft.network.protocol.game.ServerGamePacketListener;
+import net.minecraft.server.MinecraftServer;
+
+/**
+ * Serializes a vanilla packet to/from a byte array using the 1.20.6 stream codecs.
+ */
+public class PacketSerializer {
+
+    private static ProtocolInfo<ClientGamePacketListener> clientbound() {
+        return GameProtocols.CLIENTBOUND.bind(RegistryFriendlyByteBuf.decorator(MinecraftServer.getServer().registryAccess()));
+    }
+
+    private static ProtocolInfo<ServerGamePacketListener> serverbound() {
+        return GameProtocols.SERVERBOUND.bind(RegistryFriendlyByteBuf.decorator(MinecraftServer.getServer().registryAccess()));
+    }
+
+    @SuppressWarnings("unchecked")
+    public static void writeClientbound(FriendlyByteBuf out, Packet<?> packet) {
+        FriendlyByteBuf buf = new FriendlyByteBuf(Unpooled.buffer());
+        clientbound().codec().encode(buf, (Packet<? super ClientGamePacketListener>) packet);
+        out.writeByteArray(buf.array());
+    }
+
+    public static Packet<?> readClientbound(FriendlyByteBuf in) {
+        FriendlyByteBuf buf = new FriendlyByteBuf(Unpooled.wrappedBuffer(in.readByteArray()));
+        buf.maxNbtSize = Long.MAX_VALUE;
+        return clientbound().codec().decode(buf);
+    }
+
+    @SuppressWarnings("unchecked")
+    public static void writeServerbound(FriendlyByteBuf out, Packet<?> packet) {
+        FriendlyByteBuf buf = new FriendlyByteBuf(Unpooled.buffer());
+        serverbound().codec().encode(buf, (Packet<? super ServerGamePacketListener>) packet);
+        out.writeByteArray(buf.array());
+    }
+
+    public static Packet<?> readServerbound(FriendlyByteBuf in) {
+        FriendlyByteBuf buf = new FriendlyByteBuf(Unpooled.wrappedBuffer(in.readByteArray()));
+        buf.maxNbtSize = Long.MAX_VALUE;
+        return serverbound().codec().decode(buf);
+    }
+}
