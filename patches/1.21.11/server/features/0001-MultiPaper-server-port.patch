+import puregero.multipaper.ExternalServerConnection;
+import puregero.multipaper.MultiPaper;
+
+public class SpawnUpdatePacket extends ExternalServerPacket {
+
+    public static boolean updatingSpawn = false;
+
+    private final String world;
+    private final BlockPos pos;
+    private final float yaw;
+    private final float pitch;
+
+    public SpawnUpdatePacket(ServerLevel level) {
+        this.world = level.getWorld().getName();
+        net.minecraft.world.level.storage.LevelData.RespawnData spawn = level.getLevelData().getRespawnData();
+        this.pos = spawn.pos();
+        this.yaw = spawn.yaw();
+        this.pitch = spawn.pitch();
+    }
+
+    public SpawnUpdatePacket(FriendlyByteBuf in) {
+        world = in.readUtf();
+        pos = BlockPos.of(in.readLong());
+        yaw = in.readFloat();
+        pitch = in.readFloat();
+    }
+
+    @Override
+    public void write(FriendlyByteBuf out) {
+        out.writeUtf(world);
+        out.writeLong(pos.asLong());
+        out.writeFloat(yaw);
+        out.writeFloat(pitch);
+    }
+
+    @Override
+    public void handle(ExternalServerConnection connection) {
+        MultiPaper.runSync(() -> {
+            World bukkitWorld = Bukkit.getWorld(world);
+            if (bukkitWorld instanceof CraftWorld craftWorld) {
+                updatingSpawn = true;
+                ServerLevel level = craftWorld.getHandle();
+                level.setRespawnData(net.minecraft.world.level.storage.LevelData.RespawnData.of(level.dimension(), pos, yaw, pitch));
+                updatingSpawn = false;
+            }
+        });
+    }
+}
