+    public RemoveWhiteListedPlayerPacket(String name, UUID uuid) {
+        this.name = name;
+        this.uuid = uuid;
+    }
+
+    public static void broadcast(String name, UUID uuid) {
+        if (!handlingPacket && MultiPaperConfiguration.get().syncSettings.syncJsonFiles) {
